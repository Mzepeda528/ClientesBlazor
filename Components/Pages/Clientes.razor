@page "/clientes"
@inject ClienteApiService ApiService

<PageTitle>Clientes</PageTitle>

<h1>Administración de Clientes</h1>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="AbrirModalAgregar">Agregar Cliente</button>
<button class="btn btn-outline-secondary mb-3 ms-2" @onclick="CargarClientes">Actualizar lista</button>

@if (cargando)
{
    <p><em>Cargando clientes...</em></p>
}
else if (clientes.Count == 0)
{
    <p>No hay clientes registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>CUI</th>
                    <th>NIT</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Fecha de Nacimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in clientes)
                {
                    <tr>
                        <td>@cliente.Id_cliente</td>
                        <td>@cliente.CUI</td>
                        <td>@cliente.NIT</td>
                        <td>@cliente.Nombres</td>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.Direccion</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Fecha_Nacimiento.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => AbrirModalEditar(cliente)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => AbrirModalEliminar(cliente)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarModalForm)
{
    <div class="modal d-block modal-fondo" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="clienteActual" OnValidSubmit="GuardarCliente">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(editando ? "Editar Cliente" : "Agregar Cliente")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalForm"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">CUI</label>
                            <InputText class="form-control" @bind-Value="clienteActual.CUI" />
                            <ValidationMessage For="() => clienteActual.CUI" class="invalid-feedback d-block" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">NIT</label>
                            <InputText class="form-control" @bind-Value="clienteActual.NIT" />
                            <ValidationMessage For="() => clienteActual.NIT" class="invalid-feedback d-block" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nombres</label>
                            <InputText class="form-control" @bind-Value="clienteActual.Nombres" />
                            <ValidationMessage For="() => clienteActual.Nombres" class="invalid-feedback d-block" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Apellidos</label>
                            <InputText class="form-control" @bind-Value="clienteActual.Apellidos" />
                            <ValidationMessage For="() => clienteActual.Apellidos" class="invalid-feedback d-block" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputText class="form-control" @bind-Value="clienteActual.Direccion" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <InputText class="form-control" @bind-Value="clienteActual.Telefono" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha de Nacimiento</label>
                            <InputDate class="form-control" @bind-Value="clienteActual.Fecha_Nacimiento" />
                            <ValidationMessage For="() => clienteActual.Fecha_Nacimiento" class="invalid-feedback d-block" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (mostrarModalEliminar && clienteAEliminar is not null)
{
    <div class="modal d-block modal-fondo" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar a <strong>@clienteAEliminar.Nombres @clienteAEliminar.Apellidos</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente> clientes = new();
    private bool cargando = true;
    private string? mensajeError;

    private bool mostrarModalForm = false;
    private bool editando = false;
    private Cliente clienteActual = new();

    private bool mostrarModalEliminar = false;
    private Cliente? clienteAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            clientes = await ApiService.ObtenerClientesAsync();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
            clientes = new();
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalAgregar()
    {
        clienteActual = new Cliente();
        editando = false;
        mostrarModalForm = true;
    }

    private void AbrirModalEditar(Cliente cliente)
    {
        clienteActual = new Cliente
        {
            Id_cliente = cliente.Id_cliente,
            CUI = cliente.CUI,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_Nacimiento = cliente.Fecha_Nacimiento
        };
        editando = true;
        mostrarModalForm = true;
    }

    private void CerrarModalForm()
    {
        mostrarModalForm = false;
    }

    private async Task GuardarCliente()
    {
        try
        {
            if (editando)
            {
                await ApiService.ActualizarClienteAsync(clienteActual.Id_cliente, clienteActual);
            }
            else
            {
                await ApiService.CrearClienteAsync(clienteActual);
            }
            mostrarModalForm = false;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar el cliente: {ex.Message}";
        }
    }

    private void AbrirModalEliminar(Cliente cliente)
    {
        clienteAEliminar = cliente;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        clienteAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (clienteAEliminar is null) return;
        try
        {
            await ApiService.EliminarClienteAsync(clienteAEliminar.Id_cliente);
            mostrarModalEliminar = false;
            clienteAEliminar = null;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo eliminar el cliente: {ex.Message}";
        }
    }
}
