@page "/clientes"
@inject ClienteApiService ApiService

<PageTitle>Clientes</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">Administración de Clientes</h3>
            <small class="text-muted">Registro y mantenimiento de clientes</small>
        </div>
        <div>
            <button type="button" class="btn btn-outline-secondary me-2" @onclick="CargarClientes">
                Actualizar
            </button>
            <button type="button" class="btn btn-primary" @onclick="AbrirModalAgregar">
                Nuevo Cliente
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Listado de Clientes</span>
                @if (!cargando)
                {
                    <span class="badge bg-secondary">@clientes.Count registros</span>
                }
            </div>
        </div>

        <div class="card-body">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3">Cargando clientes...</p>
                </div>
            }
            else if (clientes.Count == 0)
            {
                <div class="alert alert-warning mb-0">No existen clientes registrados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>CUI</th>
                                <th>NIT</th>
                                <th>Nombres</th>
                                <th>Apellidos</th>
                                <th>Dirección</th>
                                <th>Teléfono</th>
                                <th>Fecha Nacimiento</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in clientes)
                            {
                                <tr>
                                    <td>@item.Id_cliente</td>
                                    <td>@item.CUI</td>
                                    <td>@item.NIT</td>
                                    <td>@item.Nombres</td>
                                    <td>@item.Apellidos</td>
                                    <td>@item.Direccion</td>
                                    <td>@item.Telefono</td>
                                    <td>@item.Fecha_Nacimiento.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-warning btn-sm me-1" @onclick="() => AbrirModalEditar(item)">
                                            Editar
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => AbrirModalEliminar(item)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== MODAL AGREGAR / EDITAR ===================== *@
@if (mostrarModalForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">

                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Modificar Cliente" : "Nuevo Cliente")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalForm"></button>
                </div>

                <EditForm EditContext="editContext" OnValidSubmit="GuardarCliente" OnInvalidSubmit="FormularioInvalido">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">CUI <span class="text-danger">*</span></label>
                                <InputText class="@ClaseCampo(nameof(clienteActual.CUI))" @bind-Value="clienteActual.CUI" maxlength="20" />
                                @if (CampoInvalido(nameof(clienteActual.CUI)))
                                {
                                    <div class="invalid-feedback d-block"><ValidationMessage For="() => clienteActual.CUI" /></div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">NIT <span class="text-danger">*</span></label>
                                <InputText class="@ClaseCampo(nameof(clienteActual.NIT))" @bind-Value="clienteActual.NIT" maxlength="20" />
                                @if (CampoInvalido(nameof(clienteActual.NIT)))
                                {
                                    <div class="invalid-feedback d-block"><ValidationMessage For="() => clienteActual.NIT" /></div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nombres <span class="text-danger">*</span></label>
                                <InputText class="@ClaseCampo(nameof(clienteActual.Nombres))" @bind-Value="clienteActual.Nombres" maxlength="100" />
                                @if (CampoInvalido(nameof(clienteActual.Nombres)))
                                {
                                    <div class="invalid-feedback d-block"><ValidationMessage For="() => clienteActual.Nombres" /></div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                                <InputText class="@ClaseCampo(nameof(clienteActual.Apellidos))" @bind-Value="clienteActual.Apellidos" maxlength="100" />
                                @if (CampoInvalido(nameof(clienteActual.Apellidos)))
                                {
                                    <div class="invalid-feedback d-block"><ValidationMessage For="() => clienteActual.Apellidos" /></div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Dirección</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Direccion" maxlength="200" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Telefono" maxlength="20" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha de Nacimiento <span class="text-danger">*</span></label>
                                <InputDate class="@ClaseCampo(nameof(clienteActual.Fecha_Nacimiento))" @bind-Value="clienteActual.Fecha_Nacimiento" />
                                @if (CampoInvalido(nameof(clienteActual.Fecha_Nacimiento)))
                                {
                                    <div class="invalid-feedback d-block"><ValidationMessage For="() => clienteActual.Fecha_Nacimiento" /></div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : (editando ? "Actualizar" : "Guardar"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ===================== MODAL CONFIRMAR ELIMINAR ===================== *@
@if (mostrarModalEliminar && clienteAEliminar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar a <strong>@clienteAEliminar.Nombres @clienteAEliminar.Apellidos</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente> clientes = new();
    private bool cargando = true;
    private string? mensajeExito;
    private string? mensajeError;

    private bool mostrarModalForm = false;
    private bool editando = false;
    private bool guardando = false;
    private bool formularioValidado = false;
    private Cliente clienteActual = new();
    private EditContext editContext = default!;

    private bool mostrarModalEliminar = false;
    private bool eliminando = false;
    private Cliente? clienteAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        cargando = true;
        try
        {
            clientes = await ApiService.ObtenerClientesAsync();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
            clientes = new();
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalAgregar()
    {
        clienteActual = new Cliente { Fecha_Nacimiento = DateTime.Today.AddYears(-18) };
        editContext = new EditContext(clienteActual);
        editando = false;
        formularioValidado = false;
        mostrarModalForm = true;
    }

    private void AbrirModalEditar(Cliente cliente)
    {
        clienteActual = new Cliente
        {
            Id_cliente = cliente.Id_cliente,
            CUI = cliente.CUI,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_Nacimiento = cliente.Fecha_Nacimiento
        };
        editContext = new EditContext(clienteActual);
        editando = true;
        formularioValidado = false;
        mostrarModalForm = true;
    }

    private void CerrarModalForm()
    {
        mostrarModalForm = false;
    }

    private void FormularioInvalido()
    {
        formularioValidado = true;
    }

    private async Task GuardarCliente()
    {
        guardando = true;
        formularioValidado = true;
        mensajeError = null;
        try
        {
            if (editando)
            {
                await ApiService.ActualizarClienteAsync(clienteActual.Id_cliente, clienteActual);
                mensajeExito = "Cliente actualizado correctamente.";
            }
            else
            {
                await ApiService.CrearClienteAsync(clienteActual);
                mensajeExito = "Cliente agregado correctamente.";
            }
            mostrarModalForm = false;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar el cliente: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirModalEliminar(Cliente cliente)
    {
        clienteAEliminar = cliente;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        clienteAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (clienteAEliminar is null) return;
        eliminando = true;
        mensajeError = null;
        try
        {
            await ApiService.EliminarClienteAsync(clienteAEliminar.Id_cliente);
            mensajeExito = "Cliente eliminado correctamente.";
            mostrarModalEliminar = false;
            clienteAEliminar = null;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo eliminar el cliente: {ex.Message}";
        }
        finally
        {
            eliminando = false;
        }
    }

    private string ClaseCampo(string nombreCampo)
    {
        const string claseBase = "form-control";
        if (!formularioValidado) return claseBase;

        var campo = new FieldIdentifier(clienteActual, nombreCampo);
        var tieneErrores = editContext.GetValidationMessages(campo).Any();
        return tieneErrores ? $"{claseBase} is-invalid" : $"{claseBase} is-valid";
    }

    private bool CampoInvalido(string nombreCampo)
    {
        if (!formularioValidado) return false;
        var campo = new FieldIdentifier(clienteActual, nombreCampo);
        return editContext.GetValidationMessages(campo).Any();
    }
}
